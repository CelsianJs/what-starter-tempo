{
  "headers": [
    {
      "source": "/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate, no-transform",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "source": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
