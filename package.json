{
  "name": "what-starter-tempo",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Tempo — a What Framework starter for a hybrid time-tracking SaaS on Vura.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-vura.mjs",
    "preview": "node scripts/preview-server.mjs",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "deploy": "npm run build && vura-platform deploy",
    "deploy:prod": "npm run build && vura-platform deploy --prod"
  },
  "dependencies": {
    "what-framework": "0.13.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "esbuild": "^0.25.10",
    "playwright": "1.63.0",
    "vura-platform": "0.3.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "what-compiler": "0.13.10"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
